# Backend base URL, e.g. https://your-app.onrender.com
# Leave empty to run the app against the in-browser mock backend (see src/lib/api/mock.ts).
NEXT_PUBLIC_API_URL=

# Public read-only Google Sheet of approved receipts
NEXT_PUBLIC_SHEET_URL=

# Backup demo video, shown when the backend stays unreachable
NEXT_PUBLIC_DEMO_VIDEO_URL=

# Project repository
NEXT_PUBLIC_REPO_URL=

# Force the mock backend even when NEXT_PUBLIC_API_URL is set (used by e2e tests)
NEXT_PUBLIC_USE_MOCK=0
